# Copia este archivo a .env.local y pon tu clave de https://console.groq.com/keys
# Solo la lee el servidor (api/improveField.ts); nunca llega al navegador.
# OJO: la clave va en .env.local, nunca aquí: este archivo sí se sube a git.
GROQ_API_KEY=

# Opcional. Por defecto: openai/gpt-oss-120b
# GROQ_MODEL=

# Opcional. Límite de uso compartido entre instancias (Upstash Redis o Vercel KV).
# Sin estas variables cada instancia cuenta en su memoria.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional. Dirección pública, para la imagen al compartir el enlace.
# En Vercel se toma sola de VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://cvpro.sackito.online
